#!/bin/bash
#
# Pre-commit hook to ensure code is formatted with clang-format-14
# Install: ./install-git-hooks.sh
#

# Change to repository root
cd "$(git rev-parse --show-toplevel)" || exit 1

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running clang-format check on changed files...${NC}"

# Delegate to format_code.sh --changed --check
if ! ./format_code.sh --changed --check; then
   echo ""
   echo -e "${RED}ERROR: Code is not properly formatted!${NC}"
   echo -e "${YELLOW}Please run:${NC}"
   echo -e "  ./format_code.sh --changed"
   echo -e "${YELLOW}Then stage the changes and commit again.${NC}"
   echo ""
   echo -e "${YELLOW}Or to bypass this check (not recommended):${NC}"
   echo -e "  git commit --no-verify"
   exit 1
fi

echo -e "${GREEN}Code formatting check passed!${NC}"
exit 0
