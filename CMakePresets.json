{
   "version": 3,
   "cmakeMinimumRequired": {
      "major": 3,
      "minor": 21,
      "patch": 0
   },
   "configurePresets": [
      {
         "name": "debug",
         "displayName": "Debug",
         "binaryDir": "${sourceDir}/build-debug",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug"
         }
      },
      {
         "name": "release",
         "displayName": "Release",
         "binaryDir": "${sourceDir}/build-release",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release"
         }
      },
      {
         "name": "ci",
         "displayName": "CI",
         "binaryDir": "${sourceDir}/build-ci",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug"
         }
      }
   ]
}
